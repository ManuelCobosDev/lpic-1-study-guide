{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "outDir": "./out-tsc/scripts",
    "types": ["node"]
  },
  "include": [
    "scripts/**/*.ts",
    "src/app/core/schemas/**/*.ts",
    "src/app/core/models/**/*.ts"
  ]
}
