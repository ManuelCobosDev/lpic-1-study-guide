{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lpic-1-study-guide",
  "compatibility_date": "2025-01-01",
  "assets": {
    "directory": "./dist/lpic1-study-guide/browser",
    "not_found_handling": "single-page-application"
  },
  "limits": {
    "cpu_ms": 50,
    "subrequests": 10
  }
}
