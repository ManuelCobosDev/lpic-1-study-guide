{
  "name": "lpic1-study-guide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "npm run build:content && ng serve",
    "dev": "npm run build:content && ng serve",
    "build": "tsx scripts/build-content.ts && ng build && tsx scripts/postbuild.ts",
    "postbuild": "tsx scripts/postbuild.ts",
    "build:content": "tsx scripts/build-content.ts",
    "validate:content": "tsx scripts/build-content.ts --validate",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.spec.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "lint": "eslint .",
    "test": "ng test --watch=false && vitest run --config vitest.config.ts --passWithNoTests",
    "e2e": "playwright test",
    "e2e:pendientes": "tsx scripts/run-pendientes.ts",
    "check:tokens": "tsx scripts/check-tokens.ts",
    "check:boundaries": "tsx scripts/check-boundaries.ts",
    "new:subtopic": "tsx scripts/new-subtopic.ts",
    "import:legacy": "tsx scripts/import-legacy/index.ts",
    "check:stubs": "tsx scripts/check-stubs.ts",
    "extract:pdf": "python scripts/extract-pdf/extract.py",
    "verify:coverage": "tsx scripts/coverage/verify-coverage.ts",
    "report:coverage": "tsx scripts/coverage/report-coverage.ts",
    "progress:r2": "tsx scripts/coverage/progress-r2.ts",
    "validation:register": "tsx scripts/coverage/validation-register.ts",
    "verify:validations": "tsx scripts/coverage/verify-validations.ts",
    "verify": "tsx scripts/verify.ts",
    "preview": "tsx scripts/preview.ts"
  },
  "dependencies": {
    "@angular/cdk": "^21.1.0",
    "@angular/common": "^21.1.0",
    "@angular/compiler": "^21.1.0",
    "@angular/core": "^21.1.0",
    "@angular/forms": "^21.1.0",
    "@angular/platform-browser": "^21.1.0",
    "@angular/router": "^21.1.0",
    "@fontsource-variable/inter": "^5.1.1",
    "@fontsource/jetbrains-mono": "^5.1.1",
    "d3-hierarchy": "^3.1.2",
    "d3-zoom": "^3.0.0",
    "dompurify": "^3.2.4",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "lucide-angular": "^1.0.0",
    "marked": "^15.0.7",
    "minisearch": "^7.1.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@angular/build": "^21.1.1",
    "@angular/cli": "^21.1.1",
    "@angular/compiler-cli": "^21.1.0",
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4.0.9",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/d3-zoom": "^3.0.8",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.13.5",
    "angular-eslint": "^22.6.0",
    "eslint": "^9.21.0",
    "jsdom": "^27.1.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.9",
    "tsx": "^4.19.3",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^4.0.8"
  }
}

